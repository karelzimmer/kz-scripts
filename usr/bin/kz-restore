#!/usr/bin/env bash
# shellcheck source=kz_common.sh
# #############################################################################
# SPDX-FileComment: Restore a backup copy of the Home folder.
#
# SPDX-FileCopyrightText: Karel Zimmer <info@karelzimmer.nl>
# SPDX-License-Identifier: CC0-1.0
# #############################################################################


# #############################################################################
# Imports
# #############################################################################

source kz_common.sh as kz


# #############################################################################
# Constants
# #############################################################################

readonly PROGRAM_NAME='kz-restore'
PROGRAM_DESC=$(gettext 'Restore a backup copy of the Home folder')
readonly PROGRAM_DESC
readonly PROGRAM_LOGS="systemd-cat --identifier=$PROGRAM_NAME"

USAGE="\
$(gettext 'Usage: kz restore [-C|--cli] [-G|--gui] [-h|--help] [-m|--manual]')
$(gettext '                  [-s|--source DIRECTORY] [-T|--tui] [-u|--usage]')
$(gettext '                  [-v|--version]')"
readonly USAGE

HELP="$(gettext 'Usage: kz restore [OPTIONS]')

$PROGRAM_DESC.

$(gettext 'Options:')
$(gettext "  Mandatory arguments to long options are mandatory for short \
options too.")

$(gettext '  -C, --cli      run in command-line mode')
$(gettext '  -G, --gui      run in graphical mode')
$(gettext '  -h, --help     show this help text')
$(gettext '  -m, --manual   show manual page')
$(gettext '  -s, --source DIRECTORY')
$(gettext '                 use backup in specified directory')
$(gettext '  -T, --tui      run in text-based mode (default)')
$(gettext '  -u, --usage    show a short usage summary')
$(gettext '  -v, --version  show program version')"
readonly HELP

readonly OPTIONS_SHORT='CGhms:Tuv'
readonly OPTIONS_LONG='cli,gui,help,manual,source:,tui,usage,version'


# #############################################################################
# Globals
# #############################################################################

declare -i RESTORE_RC=0
declare ERROR_LOG=''
declare MEDIUM=''
declare SOURCE=''
declare UI_MODE='tui'


# #############################################################################
# Functions
# #############################################################################

# This function performs the script actions.
process() {
    local option_source=false
    local source_argument=''

    check_input "$@"
    check_source
    restore_backup
    restore_settings
}


# This function checks the script input.
check_input() {
    local parsed=''
    local program_name=${PROGRAM_NAME/kz-/kz }

    parsed=$(
        getopt  --options       "$OPTIONS_SHORT"    \
                --longoptions   "$OPTIONS_LONG"     \
                --name          "$program_name"     \
                --              "$@"
        )   ||  {
                    UI_MODE='cli'
                    kz.infomsg "$USAGE"
                    exit 1
                }
    eval set -- "$parsed"
    unset parsed

    process_options "$@"
}


# This function handles the script options and arguments.
process_options() {
    local program_name=${PROGRAM_NAME/kz-/kz }
    local text=''

    while true; do
        case $1 in
            -G | --gui )
                if [[ -z ${XDG_CURRENT_DESKTOP-} ]]; then
                    text="$program_name: $1: \
$(gettext "no desktop environment available")"
                    kz.infomsg "$text"
                    exit 1
                fi
                UI_MODE='gui'
                shift
                ;;
            -s | --source )
                if $option_source; then
                    text="$program_name: $1 $2: $(gettext 'too many options')
$USAGE"
                    kz.infomsg "$text"
                    exit 1
                fi
                option_source=true
                source_argument=$2
                shift 2
                ;;
            -h | --help )
                kz.process_option_help
                exit 0
                ;;
            -m | --manual )
                kz.process_option_manual
                exit 0
                ;;
            -u | --usage )
                kz.process_option_usage
                exit 0
                ;;
            -v | --version )
                kz.process_option_version
                exit 0
                ;;
            -C | --cli )
                UI_MODE='cli'
                shift
                ;;
            -T | --tui )
                UI_MODE='tui'
                shift
                ;;
            -- )
                shift
                break
                ;;
            * )
                text="$PROGRAM_NAME: getopt: $(gettext 'internal error')"
                kz.errmsg "$text"
                exit 1
                ;;
        esac
    done

    if [[ -n $* ]]; then
        text="$program_name: $*: $(gettext 'arguments are not allowed')
$USAGE"
        kz.infomsg "$text"
        exit 1
    fi
}


# This function checks if the source is available.
check_source() {
    local -a media=()
    local medium=''
    local old=''
    local program_name=${PROGRAM_NAME/kz-/kz }
    local selected_medium=''
    local usb_mount_point=/media/$USER

    if grep --quiet --regexp='rhel\|fedora' /etc/os-release; then
        usb_mount_point=/run/media/$USER
    fi

    if $option_source; then
        if ! [[ -d $source_argument ]]; then
            text="$program_name: $source_argument: \
$(gettext 'directory does not exist')"
            kz.infomsg "$text"
            exit 1
        fi
        MEDIUM=$source_argument
    else
        readarray -t media < <(
            find    "$usb_mount_point/"         \
                    -mindepth 1                 \
                    -maxdepth 1                 \
                    -printf '%P\n' 2> /dev/null || true
            )
        if [[ ${#media[@]} -eq 0 ]]; then
            text="$(eval_gettext "No usb medium found on \$usb_mount_point.")

$(gettext 'Connect a usb medium.')"
            kz.infomsg "$text"
            # A second chance for the user to connect media.
            if [[ $UI_MODE = 'cli' ]]; then
                prompt=$(gettext 'Press the Enter key to continue [Enter]: ')
                read -rp "$prompt" < /dev/tty
            fi
            readarray -t media < <(
                find    "$usb_mount_point/"         \
                        -mindepth 1                 \
                        -maxdepth 1                 \
                        -printf '%P\n' 2> /dev/null || true
                )
            if [[ ${#media[@]} -eq 0 ]]; then
                kz.errmsg "$text"
                exit 1
            fi
        fi

        if [[ ${#media[@]} -eq 1 ]]; then
            MEDIUM=$usb_mount_point/${media[0]}
        else
            # If multiple media are connected, let the user select the desired
            # medium.
            select_medium
            MEDIUM=$usb_mount_point/$selected_medium

            if [[ -z $selected_medium ]]; then
                text=$(gettext 'No USB medium selected.')
                kz.infomsg "$text"
                exit 0
            fi
            MEDIUM=$usb_mount_point/$selected_medium
        fi
    fi

    SOURCE=$MEDIUM/backup_${HOSTNAME}_$USER

    old=$MEDIUM/BACKUP-$USER@$HOSTNAME
    if [[ -e $old ]]; then
        text="$(gettext 'The backup has to be renamed!')
$(eval_gettext "From: \$old")
$(eval_gettext "to  : \$SOURCE")"
        kz.infomsg "$text"
        exit 1
    fi

    old=$MEDIUM/BACKUP_${HOSTNAME}_$USER
    if [[ -e $old ]]; then
        text="$(gettext 'The backup has to be renamed!')
$(eval_gettext "From: \$old")
$(eval_gettext "to  : \$SOURCE")"
        kz.infomsg "$text"
        exit 1
    fi

    if ! [[ -d $SOURCE ]]; then
        text=$(eval_gettext "No backup_\${HOSTNAME}_\$USER found in \$MEDIUM.")
        kz.errmsg "$text"
        exit 1
    fi
}


# This function lets the user select the source medium.
select_medium() {
    local -a choices=()
    local -i max_choices=1
    local medium=''
    local prompt=''
    local text=''
    local title=''

    title=$(gettext 'Restore backup')
    text=$(gettext 'Choose USB medium:')

    if [[ $UI_MODE = 'gui' ]]; then
        for medium in "${media[@]}"; do
            choices+=('false' "$medium")
        done
        # No array is needed, because only one can be selected.
        selected_medium=$(
            zenity  --list                              \
                    --radiolist                         \
                    --separator ' '                     \
                    --width     400                     \
                    --height    500                     \
                    --title     "$title"                \
                    --text      "$text"                 \
                    --ok-label  "$(gettext 'Continue')" \
                    --column    "$(gettext 'SEL')"      \
                    --column    "$(gettext 'MEDIUM')"   \
                    "${choices[@]}"                     \
                    2> /dev/null                        || true
            )
    elif [[ $UI_MODE = 'tui' ]]; then
        for medium in "${media[@]}"; do
            choices+=("$medium" 'off')
        done
        # No array is needed, because only one can be selected.
        selected_medium=$(
            dialog  --mouse                             \
                    --no-items                          \
                    --ok-label  "$(gettext 'Continue')" \
                    --backtitle "$PROGRAM_NAME"         \
                    --title     "$title"                \
                    --radiolist "$text"                 \
                    0 0 0                               \
                    "${choices[@]}"                     \
                    2>&1 >/dev/tty                      |
            sed     --expression='s/"//g'               || true
            )
    else
        text=$(gettext 'More than one USB medium is connected.')
        printf  '%s\n\n%s\n'    \
                "$text"         \
                "$(gettext 'Choose USB medium:')"
        for medium in "${media[@]}"; do
            printf "%3d %s\n" "$max_choices" "$medium"
            max_choices=$((max_choices + 1))
        done
        printf  '%3d %s\n'      \
                "$max_choices"  \
                "$(gettext 'Exit')"

        printf '\n'
        while true; do
            prompt=$(eval_gettext "Select number [1-\$max_choices]: ")
            kz.logmsg "$prompt"
            read -rp "$prompt" < /dev/tty

            if ! [[ $REPLY =~ ^[0-9]+$ ]]; then
                continue
            elif [[ $REPLY -eq $max_choices ]]; then
                exit 0
            elif [[ $REPLY -ge 1 && $REPLY -lt $max_choices ]]; then
                selected_medium=${media[REPLY-1]}
                break
            else
                continue
            fi
        done
    fi

    if [[ -z $selected_medium ]]; then
        text=$(gettext 'No USB medium selected.')
        kz.infomsg "$text"
        exit 0
    fi
}


# This function restores the backup.
restore_backup() {
    local text=''
    local title=''

    ERROR_LOG=$(mktemp -t "$PROGRAM_NAME-error-XXXXXXXXXX.log")
    text="ERRORLOG (stderr) $ERROR_LOG"
    printf '%s\n' "$text" > "$ERROR_LOG"

    title=$(gettext 'Restore backup')
    text=$(gettext 'Preparing restore (this can take a while)')
    kz.logmsg "$title"...

    if [[ $UI_MODE = 'gui' ]]; then
        rsync   --archive                       \
                --verbose                       \
                "$SOURCE/"                      \
                "$HOME/"                        \
                2>> "$ERROR_LOG"                |
        sed     --expression='s/^/#/'           |
        zenity  --progress                      \
                --auto-close                    \
                --no-cancel                     \
                --pulsate                       \
                --width     600                 \
                --height    50                  \
                --title     "$title"            \
                --text      "$text"             \
                2> /dev/null                    || RESTORE_RC=$?
    elif [[ $UI_MODE = 'tui' ]]; then
        # This tput locks the cursor position top-left to prevent flickering.
        tput cup 0 0
        rsync   --archive                       \
                --verbose                       \
                "$SOURCE/"                      \
                "$HOME/"                        \
                2>> "$ERROR_LOG"                |
        dialog  --mouse                         \
                --backtitle "$PROGRAM_NAME"     \
                --title "$title"                \
                --progressbox                   \
                20 70                           || RESTORE_RC=$?
    else
        text+='...'
        kz.infomsg "$text"
        rsync   --archive                       \
                --verbose                       \
                --human-readable                \
                "$SOURCE/"                      \
                "$HOME/"                        \
                2>> "$ERROR_LOG"                || RESTORE_RC=$?
    fi
}


# This function restores the user settings.
restore_settings() {
    local settings_dir=$HOME/Settings

    if [[ -n ${XDG_CURRENT_DESKTOP-} ]]; then
        kz.logmsg 'Restore settings...'
        restore_setting_desktop
    fi
}


# This function restores the desktop background,.
restore_setting_desktop() {
    local input_file=$settings_dir/desktop.ico

    if type gsettings &> /dev/null && [[ -f $input_file ]]; then
        kz.logmsg 'Restore the desktop background...'
        gsettings   set                                         \
                    org.gnome.desktop.background picture-uri    \
                    "file://$input_file"
    fi
}


# This function controls the termination of the script.
term() {
    local program_name=${PROGRAM_NAME/kz-/kz }
    local prompt=''
    local text=''
    local title=''
    local usb_mount_point=/media/$USER
    local volume_name=''

    if grep --quiet --regexp='rhel\|fedora' /etc/os-release; then
        usb_mount_point=/run/media/$USER
    fi

    # Error log also to the standard log.
    text="ERRORLOG (stderr) $ERROR_LOG"
    printf '%s\n' "$text" >> "$ERROR_LOG"
    printf '%s' "$(<"$ERROR_LOG")" |& $PROGRAM_LOGS

    if [[ $RESTORE_RC -ne 0 ]]; then
        title="$PROGRAM_DESC $(gettext 'error messages')"
        text="$(gettext 'Restore ended with errors.')

$(gettext 'Possible causes:')
$(gettext 'Were any files added or deleted during the restore, or')
$(gettext 'some files may not be readable or changeable, or')
$(eval_gettext "is there not enough space on \$HOME.")

$(gettext 'Actions to take:')
$(gettext 'Check the error messages after this.')
$(gettext 'Try restoring the back up again.')"
        kz.errmsg "$text"

        if [[ $UI_MODE = 'gui' ]]; then
            zenity  --text-info                 \
                    --filename="$ERROR_LOG"     \
                    --width     700             \
                    --height    500             \
                    --title     "$title"        \
                    2> /dev/null                || true
        elif [[ $UI_MODE = 'tui' ]]; then
            dialog  --mouse                     \
                    --scrollbar                 \
                    --backtitle "$PROGRAM_NAME" \
                    --title     "$title"        \
                    --textbox   "$ERROR_LOG"    \
                    0 0                         || true
        else
            prompt=$(gettext 'Press the Enter key to continue [Enter]: ')
            read -rp "$prompt" < /dev/tty
            kz.infomsg "$title $ERROR_LOG:"
            less --no-init --quit-if-one-screen "$ERROR_LOG"
        fi
        exit 1
    fi

    text="
$(eval_gettext "The backup has been restored.")"

    # shellcheck disable=SC2034
    volume_name=${SOURCE##*/}
    if [[ $SOURCE == $usb_mount_point* ]]; then
        if umount "$SOURCE" |& $PROGRAM_LOGS; then
            text+="

$(eval_gettext "The USB medium \$volume_name can be removed.")"
        else
            text+="

$(eval_gettext "The USB medium \$volume_name could not be detached.")

$(gettext 'Possible causes:')
$(gettext "A USB medium cannot be detached when it is 'busy' - for example,")
$(gettext "when there are open files on it, or when some process has its \
working directory there.")

$(gettext 'Actions to take:')
$(eval_gettext "Leave the \$MEDIUM folder.")
$(eval_gettext "Close apps and windows related to the \$volume_name medium.")

$(gettext 'Remember to safely(!) remove the USB medium.')"
        fi
    fi
    kz.infomsg "$text"

    exit 0
}


# #############################################################################
# Main
# #############################################################################

main() {
    kz.init "$@"
    process "$@"
    term
}

main "$@"
