# #############################################################################
# Imports
# #############################################################################

import getopt
import gettext
import kz_common as kz
import os
import subprocess
import sys

gettext.bindtextdomain('kz', '/usr/share/locale')
gettext.textdomain('kz')
_ = gettext.gettext


# #############################################################################
# Constants
# #############################################################################

PROGRAM_NAME: str = 'kz-update'
PROGRAM_DESC: str = _('Update and cleanup the system')

USAGE: str = _('Usage: kz update [-h|--help] [-u|--usage] [-v|--version]')

HELP_LINES: list[str] = [
    _('Usage: kz update [OPTIONS]'),
    '',
    f'{PROGRAM_DESC}.',
    '',
    _('Options:'),
    _('  -h, --help     show this help text'),
    _('  -u, --usage    show a short usage summary'),
    _('  -v, --version  show program version'),
    ]
HELP: str = '\n'.join(HELP_LINES)
del HELP_LINES

OPTIONS_SHORT: str = 'huv'
OPTIONS_LONG: list[str] = ['help', 'usage', 'version']


# #############################################################################
# Globals
# #############################################################################


# #############################################################################
# Functions
# #############################################################################

def process(PROGRAM_NAME: str, PROGRAM_DESC: str, USAGE: str,
            HELP: str) -> None:
    """
    This function performs the script actions.
    """
    check_input(PROGRAM_NAME, PROGRAM_DESC, USAGE, HELP)
    check_sudo(PROGRAM_NAME, PROGRAM_DESC)
    perform_update(PROGRAM_NAME, PROGRAM_DESC)


def check_sudo(PROGRAM_NAME: str, PROGRAM_DESC: str) -> None:
    """
    This function checks if sudo is available.
    """
    check_sudo: list[str] = ['sudo', '--validate']
    text: str

    try:
        subprocess.run(check_sudo, check=True)
    except KeyboardInterrupt:
        text = _('Program {} has been interrupted.').format(PROGRAM_NAME)
        kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 130)
    except subprocess.CalledProcessError as exc:
        text = str(exc)
        kz.logmsg(PROGRAM_NAME, text)
        text = _('Program {} encountered an error.').format(PROGRAM_NAME)
        kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, exc.returncode)


def check_input(PROGRAM_NAME: str, PROGRAM_DESC: str, USAGE: str,
                HELP: str) -> None:
    """
    This function checks the script input.
    """
    args: list[str] = []
    err: BaseException
    opts: list[tuple[str, str]] = []
    program_name: str = PROGRAM_NAME.replace('kz-', 'kz ')
    text: str

    try:
        opts, args = getopt.gnu_getopt(sys.argv[1:], OPTIONS_SHORT,
                                       OPTIONS_LONG)
    except getopt.error as err:
        text = f'{program_name}: {err}\n{USAGE}'
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 1)

    process_options(PROGRAM_NAME, PROGRAM_DESC, USAGE, HELP, opts, args)


def process_options(PROGRAM_NAME: str, PROGRAM_DESC: str, USAGE: str,
                    HELP: str, opts: list[tuple[str, str]],
                    args: list[str]) -> None:
    """
    This function handles the script options and arguments.
    """
    arg: str = ''
    opt: str = ''
    program_name: str = PROGRAM_NAME.replace('kz-', 'kz ')
    text: str

    for opt, arg in opts:
        if opt in ('-h', '--help'):
            kz.process_option_help(PROGRAM_NAME, PROGRAM_DESC, HELP)
            kz.term(PROGRAM_NAME, 0)
        elif opt in ('-u', '--usage'):
            kz.process_option_usage(PROGRAM_NAME, PROGRAM_DESC, USAGE)
            kz.term(PROGRAM_NAME, 0)
        elif opt in ('-v', '--version'):
            kz.process_option_version(PROGRAM_NAME, PROGRAM_DESC)
            kz.term(PROGRAM_NAME, 0)
        else:
            text = f"{PROGRAM_NAME}: getopt: {_('internal error')}"
            kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
            kz.term(PROGRAM_NAME, 1)

    if args:
        text = (
            f"{program_name}: {' '.join(args)}: "
            f"{_('arguments are not allowed')}\n{USAGE}"
            )
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 1)


def perform_update(PROGRAM_NAME: str, PROGRAM_DESC: str) -> None:
    """
    This function performs the system update.
    """
    check_debian: list[str] = ['grep', '--quiet', '--regexp=debian',
                               '/etc/os-release']
    check_rhel: list[str] = ['grep', '--quiet', '--extended-regexp',
                             '--regexp=fedora|rhel', '/etc/os-release']

    custom_env = os.environ.copy()
    custom_env['DEBIAN_FRONTEND'] = 'noninteractive'
    custom_env['NEEDRESTART_MODE'] = 'a'

    if subprocess.run(check_debian,
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        text = f"{kz.BLUE}{_('UPDATE')}{kz.NORMAL}"
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        perform_update_debs(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        text = f"{kz.BLUE}{_('UPGRADE')}{kz.NORMAL}"
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        perform_upgrade_debs(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_snaps(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_flatpaks(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_extensions(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        text = f"{kz.BLUE}{_('CLEANUP')}{kz.NORMAL}"
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        perform_cleanup_debs(PROGRAM_NAME, PROGRAM_DESC, custom_env)
    elif subprocess.run(check_rhel,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL).returncode == 0:
        text = f"{kz.BLUE}{_('UPDATE')}{kz.NORMAL}"
        text = f"{kz.BLUE}{_('UPGRADE')}{kz.NORMAL}"
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        perform_upgrade_rpms(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_snaps(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_flatpaks(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        perform_update_extensions(PROGRAM_NAME, PROGRAM_DESC, custom_env)
        text = f"{kz.BLUE}{_('CLEANUP')}{kz.NORMAL}"
        kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        perform_cleanup_rpms(PROGRAM_NAME, PROGRAM_DESC, custom_env)
    else:
        text = _('fatal: unknown os release (kz-update)')
        kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 1)


def perform_update_debs(PROGRAM_NAME: str, PROGRAM_DESC: str,
                        custom_env: dict[str, str]) -> None:
    """
    This function updates installed Debian packages.
    """
    command: list[str] = ['sudo', 'apt-get', 'update']

    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_upgrade_debs(PROGRAM_NAME: str, PROGRAM_DESC: str,
                         custom_env: dict[str, str]) -> None:
    """
    This function upgrades installed Debian packages.
    """
    command: list[str] = ['sudo', 'apt-get', '--assume-yes', 'full-upgrade']

    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_update_snaps(PROGRAM_NAME: str, PROGRAM_DESC: str,
                         custom_env: dict[str, str]) -> None:
    """
    This function updates installed Snap packages.
    """
    check_snap: str = 'type snap'
    command: list[str] = ['sudo', 'snap', 'refresh']

    if subprocess.run(check_snap, shell=True,
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_update_flatpaks(PROGRAM_NAME: str, PROGRAM_DESC: str,
                            custom_env: dict[str, str]) -> None:
    """
    This function updates installed Flatpak packages.
    """
    check_flatpak: str = 'type flatpak'
    command: list[str] = ['sudo', 'flatpak', '--assumeyes', 'update']

    if subprocess.run(check_flatpak, shell=True,
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_update_extensions(PROGRAM_NAME: str, PROGRAM_DESC: str,
                              custom_env: dict[str, str]) -> None:
    """
    This function updates all enabled extensions.
    """
    check_gext: str = 'type gext'
    command: list[str] = ['gext', 'update']

    if subprocess.run(check_gext, shell=True,
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_upgrade_rpms(PROGRAM_NAME: str, PROGRAM_DESC: str,
                         custom_env: dict[str, str]) -> None:
    """
    This function upgrades installed RPM packages.
    """
    command: list[str] = ['sudo', 'dnf', 'upgrade', '--assumeyes', '--refresh']

    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_cleanup_debs(PROGRAM_NAME: str, PROGRAM_DESC: str,
                         custom_env: dict[str, str]) -> None:
    """
    This function performs a Debian packages cleanup.
    """
    command: list[str]

    command = ['sudo', 'apt-get', 'autoclean']
    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)

    command = ['sudo', 'apt-get', 'autoremove', '--assume-yes']
    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_cleanup_rpms(PROGRAM_NAME: str, PROGRAM_DESC: str,
                         custom_env: dict[str, str]) -> None:
    """
    This function performs a RPM packages cleanup.
    """
    command: list[str]

    command = ['sudo', 'dnf', 'clean', 'all']
    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)

    command = ['sudo', 'dnf', 'autoremove', '--assumeyes']
    perform_command(PROGRAM_NAME, PROGRAM_DESC, command, custom_env)


def perform_command(PROGRAM_NAME: str, PROGRAM_DESC: str,
                    command: list[str] = [],
                    custom_env: dict[str, str] = {}) -> None:
    """
    This function executes a Bash command.
    """
    exc: BaseException
    text: str

    text = f'{kz.BLUE}{' '.join(command)}{kz.NORMAL}'
    kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)

    kz.check_debian_package_manager(PROGRAM_NAME)
    try:
        subprocess.run(command, env=custom_env, check=True)
    except KeyboardInterrupt:
        text = _('Program {} has been interrupted.').format(PROGRAM_NAME)
        kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 130)
    except Exception as exc:
        text = str(exc)
        kz.logmsg(PROGRAM_NAME, text)
        text = _('Program {} encountered an error.').format(PROGRAM_NAME)
        kz.errmsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
        kz.term(PROGRAM_NAME, 1)
    print()  # Print a newline after the command output.


def term(PROGRAM_NAME: str, PROGRAM_DESC: str) -> None:
    """
    This function controls the termination of the script.
    """
    text: str

    text = f"{kz.GREEN}{_('Complete!')}{kz.NORMAL}"
    kz.infomsg(PROGRAM_NAME, PROGRAM_DESC, 'cli', text)
    kz.term(PROGRAM_NAME, 0)


# #############################################################################
# Main
# #############################################################################

kz.init(PROGRAM_NAME)
process(PROGRAM_NAME, PROGRAM_DESC, USAGE, HELP)
term(PROGRAM_NAME, PROGRAM_DESC)
