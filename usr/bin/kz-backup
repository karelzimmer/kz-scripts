#!/usr/bin/env bash
# shellcheck source=kz_common.sh
# #############################################################################
# SPDX-FileComment: Make a backup copy of the Home folder.
#
# SPDX-FileCopyrightText: Karel Zimmer <info@karelzimmer.nl>
# SPDX-License-Identifier: CC0-1.0
# #############################################################################


# #############################################################################
# Imports
# #############################################################################

source kz_common.sh as kz


# #############################################################################
# Constants
# #############################################################################

readonly PROGRAM_NAME='kz-backup'
PROGRAM_DESC=$(gettext 'Make a backup copy of the Home folder')
readonly PROGRAM_DESC
readonly PROGRAM_LOGS="systemd-cat --identifier=$PROGRAM_NAME"

USAGE="\
$(gettext "Usage: kz backup [-C|--cli] [-G|--gui] [-h|--help]")
$(gettext "                 [-t|--target DIRECTORY] [-T|--tui] [-u|--usage]")
$(gettext "                 [-v|--version]")"
readonly USAGE

HELP="$(gettext "Usage: kz backup [OPTIONS]")

$PROGRAM_DESC.

$(gettext 'Options:')
$(gettext "  Mandatory arguments to long options are mandatory for short \
options too.")

$(gettext '  -C, --cli      run in command-line mode')
$(gettext '  -G, --gui      run in graphical mode')
$(gettext '  -h, --help     show this help text')
$(gettext '  -t, --target DIRECTORY')
$(gettext '                 place backup in specified directory')
$(gettext '  -T, --tui      run in text-based mode (default)')
$(gettext '  -u, --usage    show a short usage summary')
$(gettext '  -v, --version  show program version')"
readonly HELP

readonly OPTIONS_SHORT='CGht:Tuv'
readonly OPTIONS_LONG='cli,gui,help,target:,tui,usage,version'


# #############################################################################
# Globals
# #############################################################################

declare -i BACKUP_RC=0
declare ERROR_LOG=''
declare MEDIUM=''
declare TARGET=''
declare UI_MODE='tui'


# #############################################################################
# Functions
# #############################################################################

# This function performs the script actions.
process() {
    local option_target=false
    local target_argument=''

    check_input "$@"
    check_target
    backup_settings
    create_backup
}


# This function checks the script input.
check_input() {
    local parsed=''
    local program_name=${PROGRAM_NAME/kz-/kz }

    parsed=$(
        getopt  --options       "$OPTIONS_SHORT"    \
                --longoptions   "$OPTIONS_LONG"     \
                --name          "$program_name"     \
                --              "$@"
        )   ||  {
                    UI_MODE='cli'
                    kz.infomsg "$USAGE"
                    exit 1
                }
    eval set -- "$parsed"
    unset parsed

    kz.process_options "$@"
    process_options "$@"
}


# This function handles the script options and arguments.
process_options() {
    local program_name=${PROGRAM_NAME/kz-/kz }
    local text=''

    while true; do
        case $1 in
            -C | --cli )
                UI_MODE='cli'
                shift
                ;;
            -G | --gui )
                if [[ -z ${XDG_CURRENT_DESKTOP-} ]]; then
                    text="$program_name: $1: \
$(gettext "no desktop environment available")"
                    kz.infomsg "$text"
                    exit 1
                fi
                UI_MODE='gui'
                shift
                ;;
            -t | --target )
                if $option_target; then
                    text="$program_name: $1 $2: $(gettext 'too many options')
$USAGE"
                    kz.infomsg "$text"
                    exit 1
                fi
                option_target=true
                target_argument=$2
                shift 2
                ;;
            -T | --tui )
                UI_MODE='tui'
                shift
                ;;
            -- )
                shift
                break
                ;;
            * )
                text="$PROGRAM_NAME: getopt: $(gettext 'internal error')"
                kz.errmsg "$text"
                exit 1
                ;;
        esac
    done

    if [[ -n $* ]]; then
        text="$program_name: $*: $(gettext 'arguments are not allowed')
$USAGE"
        UI_MODE='cli'
        kz.infomsg "$text"
        exit 1
    fi
}


# This function checks if the target is available.
check_target() {
    local -a media=()
    local medium=''
    local old=''
    local program_name=${PROGRAM_NAME/kz-/kz }
    local selected_medium=''
    local text=''
    local usb_mount_point=/media/$USER

    # Correct mouint point for Red Hat and Fedora systems.
    if grep --quiet --regexp='rhel\|fedora' /etc/os-release; then
        usb_mount_point=/run/media/$USER
    fi

    if $option_target; then
        if ! [[ -d $target_argument ]]; then
            text="$program_name: $target_argument: \
$(gettext 'directory does not exist')"
            kz.infomsg "$text"
            exit 1
        fi
        MEDIUM=$target_argument
    else
        check_target_for_user_action
        if [[ ${#media[@]} -eq 1 ]]; then
            MEDIUM=$usb_mount_point/${media[0]}
        else
            # If multiple media are connected, let the user select the desired
            # medium.
            select_medium
            MEDIUM=$usb_mount_point/$selected_medium
        fi
    fi

    TARGET=$MEDIUM/backup_${HOSTNAME}_$USER
    check_target_for_old_backups
}


# This function checks if the target is made available by the user.
check_target_for_user_action() {
    readarray -t media < <(
        find    "$usb_mount_point/"         \
                -mindepth 1                 \
                -maxdepth 1                 \
                -printf '%P\n' 2> /dev/null || true
        )
    if [[ ${#media[@]} -eq 0 ]]; then
        text="$(eval_gettext "No usb medium found on \$usb_mount_point.")

$(gettext 'Connect a usb medium.')"
        kz.infomsg "$text"
        # A second chance for the user to connect media.
        if [[ $UI_MODE = 'cli' ]]; then
            prompt=$(gettext 'Press the Enter key to continue [Enter]: ')
            read -rp "$prompt" < /dev/tty
        fi
        readarray -t media < <(
            find    "$usb_mount_point/"         \
                    -mindepth 1                 \
                    -maxdepth 1                 \
                    -printf '%P\n' 2> /dev/null || true
            )
        if [[ ${#media[@]} -eq 0 ]]; then
            kz.errmsg "$text"
            if [[ $UI_MODE = 'cli' ]]; then
                read -rp "$prompt" < /dev/tty
            fi
            exit 1
        fi
    fi
}


# This function checks for old backups and prompts the user to rename them.
# It exits the script if old backups are found.
check_target_for_old_backups() {
    old=$MEDIUM/BACKUP-$USER@$HOSTNAME
    if [[ -e $old ]]; then
        text="$(gettext 'The backup has to be renamed!')
$(eval_gettext "From: \$old")
$(eval_gettext "to  : \$TARGET")"
        kz.infomsg "$text"
        exit 1
    fi

    old=$MEDIUM/BACKUP_${HOSTNAME}_$USER
    if [[ -e $old ]]; then
        text="$(gettext 'The backup has to be renamed!')
$(eval_gettext "From: \$old")
$(eval_gettext "to  : \$TARGET")"
        kz.infomsg "$text"
        exit 1
    fi
}


# This function lets the user select the target medium.
select_medium() {
    local -a choices=()
    local medium=''
    local text=''
    local title=''

    title=$(gettext 'Make backup')
    text=$(gettext 'Select a USB medium:')

    if [[ $UI_MODE = 'gui' ]]; then
        select_medium_gui
    elif [[ $UI_MODE = 'tui' ]]; then
        select_medium_tui
    else
        select_medium_cli
    fi

    if [[ -z $selected_medium ]]; then
        text=$(gettext 'No USB medium selected.')
        kz.infomsg "$text"
        exit 0
    fi
}


# This function lets the user select the target medium in the GUI.
select_medium_gui() {
    for medium in "${media[@]}"; do
        choices+=('false' "$medium")
    done
    # No array is needed, because only one can be selected.
    selected_medium=$(
        zenity  --list                              \
                --radiolist                         \
                --separator ' '                     \
                --width     400                     \
                --height    500                     \
                --title     "$title"                \
                --text      "$text"                 \
                --ok-label  "$(gettext 'Continue')" \
                --column    "$(gettext 'SELECT')"   \
                --column    "$(gettext 'MEDIUM')"   \
                "${choices[@]}"                     \
                2> /dev/null                        || true
        )
}


# This function lets the user select the target medium using a TUI.
select_medium_tui() {
    for medium in "${media[@]}"; do
        choices+=("$medium" 'off')
    done
    # No array is needed, because only one can be selected.
    selected_medium=$(
        dialog  --mouse                             \
                --no-items                          \
                --ok-label  "$(gettext 'Continue')" \
                --backtitle "$PROGRAM_NAME"         \
                --title     "$title"                \
                --radiolist "$text"                 \
                0 0 0                               \
                "${choices[@]}"                     \
                2>&1 >/dev/tty                      |
        sed     --expression='s/"//g'               || true
        )
}


# This function lets the user select the target medium via the CLI.
select_medium_cli() {
    local prompt=''
    local max_choices=1

    text=$(gettext 'More than one USB medium is connected.')
    printf  '%s\n\n%s\n'    \
            "$text"         \
            "$(gettext 'Select a USB medium:')"
    for medium in "${media[@]}"; do
        printf "%3d %s\n" "$max_choices" "$medium"
        max_choices=$((max_choices + 1))
    done
    printf  '%3d %s\n'      \
            "$max_choices"  \
            "$(gettext 'Exit')"

    printf '\n'
    while true; do
        prompt=$(eval_gettext "Select number [1-\$max_choices]: ")
        kz.logmsg "$prompt"
        read -rp "$prompt" < /dev/tty

        if ! [[ $REPLY =~ ^[0-9]+$ ]]; then
            continue
        elif [[ $REPLY -eq $max_choices ]]; then
            exit 0
        elif [[ $REPLY -ge 1 && $REPLY -lt $max_choices ]]; then
            selected_medium=${media[REPLY-1]}
            break
        else
            continue
        fi
    done
}


# This function backups the user settings.
backup_settings() {
    local settings_dir=''

    kz.logmsg 'Backup settings...'

    settings_dir=$HOME/Settings
    if ! [[ -d $settings_dir ]]; then
        mkdir --verbose "$settings_dir" |& $PROGRAM_LOGS
    fi

    backup_setting_apps
    backup_setting_readme
    backup_setting_users

    if [[ -n ${XDG_CURRENT_DESKTOP-} ]]; then
        backup_setting_avatar
        backup_setting_desktop
        backup_setting_favorites
    fi

    # Remove old naming of folders/files.
    rm  --force                     \
        --recursive                 \
        --verbose                   \
        "$HOME/.kz-backup-settings" \
        "$HOME/.kz"                 \
        "$HOME/Instellingen"        \
        "$HOME/kz-backup"           |& $PROGRAM_LOGS
    rm  --force                     \
        --verbose                   \
        "$settings_dir/avatar"      \
        "$settings_dir/desktop"     \
        "$settings_dir/favs.txt"    \
        "$settings_dir/wifi.txt"    |& $PROGRAM_LOGS
}

# This function creates a list of installed apps.
backup_setting_apps() {
    local footer1=''
    local footer2=''
    local header1=''
    local header2=''
    local header3=''
    local footer3=''
    local output_file=$settings_dir/apps.txt
    local text=''

    header1=$(gettext "START list of manual installed packages")
    footer1=$(gettext "END list of manual installed packages")
    header2=$(gettext "START list of installed snaps")
    footer2=$(gettext "END list of installed snaps")
    header3=$(gettext "START list of installed Flatpak apps")
    footer3=$(gettext "END list of installed Flatpak apps")

    kz.logmsg 'Create a list of installed apps...(ignore WARNING).'

    printf '%s\n' "$header1" > "$output_file"
    apt list                \
        --manual-installed  \
        2> /dev/null        |
    cut --delimiter='/'     \
        --fields=1          >> "$output_file" || true
    printf '%s\n' "$footer1" >> "$output_file"

    if type snap &> /dev/null; then
        {
            printf '\n%s\n' "$header2"
            snap list
            printf '%s\n' "$footer2"
        } >> "$output_file"
    fi

    if type flatpak &> /dev/null; then
        {
            printf '\n%s\n' "$header3"
            flatpak list
            printf '%s\n' "$footer3"
        } >> "$output_file"
    fi
}


# This function creates a README.
backup_setting_readme() {
    local output_file=$settings_dir/README
    local text=''

    kz.logmsg 'Create settings README...'

    text="$(gettext 'This folder contains files created by kz-backup.')
$(gettext 'These files are used by kz-restore and others.')

$(gettext 'Further reading:')\n"
    text+='  man kz backup\n'
    text+='  man kz restore\n'
    text+='  man kz setup'
    printf '%b\n' "$text" > "$output_file"
}


# This function saves instructions for adding additional users.
backup_setting_users() {
    local groups=''
    local output_file=$settings_dir/users.txt
    local text=''
    local user=''
    local users=''

    users=$(
        gettext 'USERNAME|UID|GID|USER'
        printf  '\n'
        grep    --regexp='/bin/bash'    \
                /etc/passwd             |
        grep    --regexp='root'         \
                --invert-match          |
        cut     --delimiter=':'         \
                --fields=1,3-5          |
        tr      ',,,' '   '             |
        tr      ':' '|'
        )
    groups=$(
        while read -r user; do
            printf '\n'
            id "$user"
        done < <(
            grep    --regexp='/home'    \
                    /etc/passwd         |
            cut     --delimiter=':'     \
                    --fields=1)
            )

    kz.logmsg 'Save instructions for adding additional users...'
    if [[ -n ${XDG_CURRENT_DESKTOP-} ]]; then
        backup_setting_users_gui
    else
        backup_setting_users_cli
    fi

    printf '%s\n' "$text" > "$output_file"
}


# This function saves instructions for adding additional users in the GUI.
backup_setting_users_gui() {
    text="$(gettext 'Additional users can be added manually:')

$(gettext "1. Press the Super key[1], type 'user' and click behind Settings \
on Users.")
$(gettext '2. Click on Unlock and then Add User.')
$(gettext '3. Enter Name [USER] and Username [USERNAME].')

$(gettext '[1] Windows, command, or magnifying glass key.')

$users
$groups"
}


# This function saves instructions for adding additional users via the CLI.
backup_setting_users_cli() {
    text="$(gettext 'Additional users can be added manually:')

$(gettext '# Standard user:')
$(gettext "sudo useradd --create-home --comment '[USER]' [USERNAME]")
$(gettext '# Administrator:')
$(gettext '# Debian or Debian-based:')
$(gettext 'sudo usermod --append --groups adm,sudo [USERNAME]')
$(gettext '# Red Hat or Red Hat-based:')
$(gettext 'sudo usermod --append --groups wheel [USERNAME]')
$(gettext '# User sets password on first login:')
$(gettext 'sudo passwd --delete --expire [USERNAME]')

$users
$groups"
}


# This function copies the user avatar and saves instructions for restoring, if
# possible.
backup_setting_avatar() {
    local input_file=/var/lib/AccountsService/icons/$USER
    local output_file_1=$settings_dir/avatar.ico
    local output_file_2=$settings_dir/avatar.txt
    local text=''

    if [[ -f $input_file ]]; then
        kz.logmsg 'Copy the user avatar...'
        cp --verbose "$input_file" "$output_file_1" |& $PROGRAM_LOGS
    fi

    kz.logmsg 'Save instructions for restoring the avatar...'

    text="$(gettext 'To set the users avatar:')

$(gettext "1. Press the Super key[1], type 'user' and click behind Settings \
on Users.")
$(gettext '2. Click on Change avatar (pencil icon).')
$(gettext '3. Click Select a file.')
$(gettext '4. Select avatar.ico in Personal folder / Settings,')
$(gettext '   or another picture file.')

$(gettext '[1] Windows, command, or magnifying glass key.')"

    printf '%s\n' "$text" > "$output_file_2"
}


# This function saves the favorite apps in the dash.
backup_setting_favorites() {
    local footer1=''
    local header1=''
    local output_file=$settings_dir/favorites.txt

    header1=$(gettext "START list of favorite apps in the dash")
    footer1=$(gettext "END list of favorite apps in the dash")

    kz.logmsg 'Save the favorite apps...'

    printf '%s\n' "$header1" > "$output_file"
    gsettings   get                             \
                org.gnome.shell favorite-apps   |
                tr '[' ' '                      |
                tr ']' ' '                      |
                tr "'" ' '                      |
                tr --delete ' '                 |
                tr ',' '\n'                     \
                >> "$output_file"               |& $PROGRAM_LOGS || true
    printf '%s\n' "$footer1" >> "$output_file"
}


# This function copies the desktop background, if available, and saves
# instructions for setting desktop background.
backup_setting_desktop() {
    local input_file
    local output_file_1=$settings_dir/desktop.ico
    local output_file_2=$settings_dir/desktop.txt
    local text=''

    input_file=$(
        gsettings get org.gnome.desktop.background picture-uri  |
        sed --expression='s|%20| |g'                            |
        sed --expression="s/'//g"                               |
        sed --expression='s|file://||'                          || true
        )

    # By default, the Debian input_file retrieved with gsettings results in
    # /usr/share/images/desktop-base/desktop-background.xml, which is not an
    # image file, and restoring it from xdg-user-dir to gsettings doesn't work.
    if [[ -f $input_file && $input_file != *.xml ]]; then
        kz.logmsg 'Copy the desktop background...'
        cp "$input_file" "$output_file_1" |& $PROGRAM_LOGS || true
    fi

    kz.logmsg 'Save instructions for setting the desktop background...'

    text="$(gettext 'To set the desktop background:')

$(gettext "1.  Press the Super key[1], type 'file' and click on Files.")
$(gettext '2.  Right-click on desktop.ico in Personal folder / Settings,')
$(gettext '    or another picture file, and choose Set as Background.')

$(gettext '[1] Windows, command, or magnifying glass key.')"

    printf '%s\n' "$text" > "$output_file_2"
}


# This function creates the backup.
create_backup() {
    local exclude_file=''
    local text=''
    local title=''

    exclude_file=$(mktemp -t "$PROGRAM_NAME-exclude-XXXXXXXXXX.list")

    cat <<EOF > "$exclude_file"
# Exclude cache files
.cache/
# Exclude Git-managed directories
$(find "$HOME" -type d -name ".git" -printf "%P\n" | sed 's|/.git||')
EOF

    ERROR_LOG=$(mktemp -t "$PROGRAM_NAME-error-XXXXXXXXXX.log")
    text="ERRORLOG (stderr) $ERROR_LOG"
    printf '%s\n' "$text" > "$ERROR_LOG"

    title=$(gettext 'Make backup')
    text=$(gettext 'Preparing backup (this may take a while)')
    kz.logmsg "$title"...

    if [[ $UI_MODE = 'gui' ]]; then
        create_backup_gui
    elif [[ $UI_MODE = 'tui' ]]; then
        create_backup_tui
    else
        create_backup_cli
    fi
}


# This function creates the backup in the GUI.
create_backup_gui() {
    rsync   --archive                       \
            --verbose                       \
            --delete                        \
            --exclude-from="$exclude_file"  \
            --delete-excluded               \
            "$HOME/"                        \
            "$TARGET/"                      \
            2>> "$ERROR_LOG"                |
    sed     --expression='s/^/#/'           |
    zenity  --progress                      \
            --auto-close                    \
            --no-cancel                     \
            --pulsate                       \
            --width     600                 \
            --height    50                  \
            --title     "$title"            \
            --text      "$text"             \
            2> /dev/null                    || BACKUP_RC=$?

    text=$(gettext "Writing data from memory (this may take a while)")
    kz.logmsg "$text"...
    sync                                    |
    zenity  --progress                      \
            --pulsate                       \
            --auto-close                    \
            --no-cancel                     \
            --width     600                 \
            --height    50                  \
            --title     "$title"            \
            --text      "$text"             \
            1> >($PROGRAM_LOGS)             \
            2>> "$ERROR_LOG"
}


# This function creates the backup using a TUI.
create_backup_tui() {
    # This tput locks the cursor position top-left to prevent flickering.
    tput cup 0 0
    rsync   --archive                       \
            --verbose                       \
            --delete                        \
            --exclude-from="$exclude_file"  \
            --delete-excluded               \
            "$HOME/"                        \
            "$TARGET/"                      \
            2>> "$ERROR_LOG"                |
    dialog  --mouse                         \
            --backtitle "$PROGRAM_NAME"     \
            --title "$title"                \
            --progressbox                   \
            20 70                           || BACKUP_RC=$?

    text=$(gettext "Writing data from memory (this may take a while)")
    kz.logmsg "$text"...
    text+='...'
    dialog  --mouse                     \
            --backtitle "$PROGRAM_NAME" \
            --title     "$title"        \
            --infobox   "$text"         \
            0 0                         || true
    sync 1> >($PROGRAM_LOGS) 2>> "$ERROR_LOG"
}


# This function creates the backup via the CLI.
create_backup_cli() {
    text+='...'
    kz.infomsg "$text"
    rsync   --archive                       \
            --verbose                       \
            --human-readable                \
            --delete                        \
            --exclude-from="$exclude_file"  \
            --delete-excluded               \
            "$HOME/"                        \
            "$TARGET/"                      \
            2>> "$ERROR_LOG"                || BACKUP_RC=$?

    text=$(gettext "Writing data from memory (this may take a while)")
    kz.logmsg "$text"...
    text+='...'
    kz.infomsg "$text"
    sync 1> >($PROGRAM_LOGS) 2>> "$ERROR_LOG"
}


# This function controls the termination of the script.
term() {
    local program_name=${PROGRAM_NAME/kz-/kz }
    local prompt=''
    local text=''
    local title=''
    local usb_mount_point=/media/$USER
    local volume_name=''

    # Correct mouint point for Red Hat and Fedora systems.
    if grep --quiet --regexp='rhel\|fedora' /etc/os-release; then
        usb_mount_point=/run/media/$USER
    fi

    # Error log also to the standard log.
    text="ERRORLOG (stderr) $ERROR_LOG"
    printf '%s\n' "$text" >> "$ERROR_LOG"
    printf '%s' "$(<"$ERROR_LOG")" |& $PROGRAM_LOGS

    if [[ $BACKUP_RC -eq 0 ]]; then
        term_success
    else
        term_error
    fi
}


# This function controls the termination of the script when it ends with
# success.
term_success() {
    text="
$(gettext 'The backup has been made.')"

    if [[ $TARGET == $usb_mount_point* ]]; then
        # shellcheck disable=SC2034
        volume_name=${MEDIUM##*/}
        if umount "$MEDIUM" |& $PROGRAM_LOGS; then
            text+="

$(eval_gettext "The USB medium \$volume_name can be removed.")"
        else
            text+="

$(eval_gettext "The USB medium \$volume_name could not be detached.")

$(gettext 'Possible causes:')
$(gettext "A USB medium cannot be detached when it is 'busy' - for example,")
$(gettext "when there are open files on it, or when some process has its \
working directory there.")

$(gettext 'Actions to take:')
$(eval_gettext "Leave the \$MEDIUM folder.")
$(eval_gettext "Close apps and windows related to the \$volume_name medium.")

$(gettext 'Remember to safely(!) remove the USB medium.')"
        fi
    fi
    kz.infomsg "$text"
    exit 0
}


# This function controls the termination of the script when it ends with
# errors.
term_error() {
    title="$PROGRAM_DESC $(gettext 'error messages')"
    text="$(gettext 'Backup ended with errors.')

$(gettext 'Possible causes:')
$(gettext 'Were any files added or deleted during the backup, or')
$(gettext 'some files may not be readable or changeable, or')
$(eval_gettext "is there not enough space on \$TARGET.")

$(gettext 'Actions to take:')
$(gettext 'Check the error messages after this.')
$(gettext 'Try creating the back up again.')"
    kz.errmsg "$text"

    if [[ $UI_MODE = 'gui' ]]; then
        zenity  --text-info                 \
                --filename="$ERROR_LOG"     \
                --width     700             \
                --height    500             \
                --title     "$title"        \
                2> /dev/null                || true
    elif [[ $UI_MODE = 'tui' ]]; then
        dialog  --mouse                     \
                --scrollbar                 \
                --backtitle "$PROGRAM_NAME" \
                --title     "$title"        \
                --textbox   "$ERROR_LOG"    \
                0 0                         || true
    else
        prompt=$(gettext 'Press the Enter key to continue [Enter]: ')
        read -rp "$prompt" < /dev/tty
        kz.infomsg "$title $ERROR_LOG:"
        less --no-init --quit-if-one-screen "$ERROR_LOG"
    fi
    exit 1
}


# #############################################################################
# Main
# #############################################################################

main() {
    kz.init "$@"
    process "$@"
    term
}

main "$@"
