msgstr "Instellingenbestand '$settings_file' niet gevonden."

#: kz-setup:394 kz-setup:543
msgid ""
"Use \"kz setup APP...\" or \"kz setup --select\" to set up the self-selected "
"apps."
msgstr ""
"Gebruik \"kz setup APP...\" of \"kz setup --select\" om de zelfgekozen apps "
"in te stellen."

#: kz-setup:396
msgid ""
"Use \"kz setup --cat APP...\" to view the self-selected commands and "
"information."
msgstr ""
"Gebruik \"kz setup --cat APP...\" om de zelfgekozen opdrachten en informatie "
"te bekijken."

#: kz-setup:398
msgid ""
"Use \"kz setup --cat\" to view the automatically selected commands and "
"information."
msgstr ""
"Gebruik \"kz setup --cat\" om de automatisch geselecteerde opdrachten en "
"informatie te bekijken."

#: kz-setup:403 kz-setup:549
msgid ""
"Use \"kz setup --reset APP...\" or \"kz setup --select --reset\" to reset "
"the self-selected apps."
msgstr ""
"Gebruik \"kz setup --reset APP...\" of \"kz setup --select --reset\" om de "
"zelfgekozen apps te resetten."

#: kz-setup:405
msgid ""
"Use \"kz setup --cat --reset APP...\" to view the self-selected commands and "
"information."
msgstr ""
"Gebruik \"kz setup --cat --reset APP...\" om de zelfgekozen opdrachten en "
"informatie te bekijken."

#: kz-setup:407
msgid ""
"Use \"kz setup --cat --reset\" to view the automatically selected commands "
"and information."
msgstr ""
"Gebruik \"kz setup --cat --reset\" om de automatisch geselecteerde "
"opdrachten en informatie te bekijken."

#: kz-setup:411
msgid "Use \"kz setup --browse\" to view all commands and information."
msgstr ""
"Gebruik \"kz setup --browse\" om alle opdrachten en informatie te bekijken."

#: kz-setup:430
msgid "Select apps to set up:"
msgstr "Selecteer apps om in te stellen:"

#: kz-setup:432
msgid "Reset apps"
msgstr "Apps resetten"

#: kz-setup:433
msgid "Select apps to reset:"
msgstr "Selecteer apps om te resetten:"

#: kz-setup:545
msgid "Use \"kz setup\" to set up the automatically selected apps."
msgstr ""
"Gebruik \"kz setup\" om de automatisch geselecteerde apps in te stellen."

#: kz-setup:551
msgid "Use \"kz setup --reset\" to reset the automatically selected apps."
msgstr ""
"Gebruik \"kz setup --reset\" om de automatisch geselecteerde apps te "
"resetten."

#: kz-setup:692
msgid "Preparing set up"
msgstr "Instellen voorbereiden"

#: kz-setup:887
msgid "The set up of the following apps contains errors:"
msgstr "Het instellen van de volgende apps bevat fouten:"

#: kz-setup:894
msgid "Try to set up the apps again."
msgstr "Probeer de apps opnieuw in te stellen."

#: kz-setup:896
msgid "Try to reset the apps again."
msgstr "Probeer de apps opnieuw te resetten."

#: kz-setup:828
msgid "Apps set up completed."
msgstr "Apps instellen is voltooid."

#: kz-setup:830
msgid "Apps reset completed."
msgstr "Apps resetten is voltooid."

#: kz-setup:837
msgid ""
"You will now be logged out of the computer to finish setting up the apps and "
"changing user settings."
msgstr ""
"U wordt nu afgemeld bij de computer om het instellen van de apps en het "
"wijzigen van de gebruikersinstellingen te voltooien."

#: kz-setup:842
msgid ""
"Type 'logout' to log out of the computer to finish setting up the apps and "
"changing user settings."
msgstr ""
"Typ 'logout' om uit te loggen van de computer om het instellen van de apps "
"en het wijzigen van de gebruikersinstellingen te voltooien."

#: kz-setup:876
msgid "Log out of the computer yourself."
msgstr "Meld u zelf af van de computer."

