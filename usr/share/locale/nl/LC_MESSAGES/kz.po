#: kz-backup:445
msgid "USERNAME|UID|GID|USER"
msgstr "GEBRUIKERSNAAM|UID|GID|GEBRUIKER"

#: kz-backup:470 kz-backup:482
msgid "Additional users can be added manually:"
msgstr "Extra gebruikers kunnen handmatig worden toegevoegd:"

#: kz-backup:472 kz-backup:519
msgid ""
"1. Press the Super key[1], type 'user' and click behind Settings on Users."
msgstr ""
"1. Druk op de Super-toets[1], typ 'gebr' en klik achter Instellingen op "
"Gebruikers."

#: kz-backup:474
msgid "2. Click on Unlock and then Add User."
msgstr "2. Klik op Ontgrendelen en vervolgens op Gebruiker toevoegen."

#: kz-backup:475
msgid "3. Enter Name [USER] and Username [USERNAME]."
msgstr "3. Vul in Naam [GEBRUIKER] en Gebruikersnaam [GEBRUIKERSNAAM]."

#: kz-backup:477 kz-backup:526 kz-backup:580
msgid "[1] Windows, command, or magnifying glass key."
msgstr "[1] Windows-, command- of vergrootglastoets."

#: kz-backup:484
msgid "# Standard user:"
msgstr "# Standaard gebruiker:"

#: kz-backup:485
msgid "sudo useradd --create-home --comment '[USER]' [USERNAME]"
msgstr "sudo useradd --create-home --comment '[GEBRUIKER]' [GEBRUIKERSNAAM]"

#: kz-backup:486
msgid "# Administrator:"
msgstr "# Beheerder:"

#: kz-backup:487
msgid "# Debian or Debian-based:"
msgstr "# Debian of Debian-gebaseerd:"

#: kz-backup:488
msgid "sudo usermod --append --groups adm,sudo [USERNAME]"
msgstr "sudo usermod --append --groups adm,sudo [GEBRUIKERSNAAM]"

#: kz-backup:489
msgid "# Red Hat or Red Hat-based:"
msgstr "# Red Hat of Red Hat-gebaseerd:"

#: kz-backup:490
msgid "sudo usermod --append --groups wheel [USERNAME]"
msgstr "sudo usermod --append --groups wheel [GEBRUIKERSNAAM]"

#: kz-backup:491
msgid "# User sets password on first login:"
msgstr "# Gebruiker kan wachtwoord instellen bij de eerste keer aanmelden:"

#: kz-backup:492
msgid "sudo passwd --delete --expire [USERNAME]"
msgstr "sudo passwd --delete --expire [GEBRUIKERSNAAM]"

#: kz-backup:517
msgid "To set the users avatar:"
msgstr ""

msgid ""
"1. Press the Super key[1], type \"user\" and click behind Settings on Users."
msgstr ""
"1. Druk op de Super-toets[1], typ 'gebr' en klik achter Instellingen op "
"Gebruikers."

#: kz-backup:521
msgid "2. Click on Change avatar (pencil icon)."
msgstr "2. Klik op Avatar veranderen (potloodpictogram)."

#: kz-backup:522
msgid "3. Click Select a file."
msgstr "3. Klik op Selecteer een bestand."

#: kz-backup:523
msgid "4. Select avatar.ico in Personal folder / Settings,"
msgstr "4. Selecteer avatar.ico in Persoonlijke map / Instellingen,"

#: kz-backup:524
msgid "   or another picture file."
msgstr "   of een ander afbeeldingsbestand."

#: kz-backup:574
msgid "To set the desktop background:"
msgstr "Om de bureaubladachtergrond in te stellen:"

#: kz-backup:576
msgid "1.  Press the Super key[1], type 'file' and click on Files."
msgstr "1.  Druk op de Super-toets[1], typ 'best' en klik op Bestanden."

#: kz-backup:577
msgid "2.  Right-click on desktop.ico in Personal folder / Settings,"
msgstr "2.  Rechtsklik op desktop.ico in Persoonlijke map / Settings,"

#: kz-backup:578
msgid "    or another picture file, and choose Set as Background."
msgstr ""
"    of een ander afbeeldingsbestand, en kies Instellen als "
"bureaubladachtergrond."

